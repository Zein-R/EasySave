<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HomeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#D3A373"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Background"
                                   Fill="#D3A373"
                                   RadiusX="10" RadiusY="10"/>
                        <Image Source="{TemplateBinding Tag}"
                               Width="50" Height="50" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding Content}" 
                                   Foreground="White" FontSize="23" FontFamily="/Fonts/#Roboto" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,20"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Fill" Value="#E8CFA9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Background" Property="Fill" Value="#B5884D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>