<Page x:Class="EasySave.NS_View.AddWorkView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:model="clr-namespace:EasySave.NS_Model"
      xmlns:local="clr-namespace:EasySave.NS_View"
      xmlns:language="clr-namespace:EasySave.Langs"

      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="AddWorkView">


    <Grid Background="#FEFADF" RenderTransformOrigin="1,0.5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="2"/>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="1" Grid.Row="0">
            <StackPanel Grid.Column="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style>
                        <Style.Triggers>
                            <Trigger Property="StackPanel.IsMouseOver" Value="True">
                                <Setter Property="Border.BorderBrush" Value="Black" />
                                <Setter Property="Button.Background" Value="Black" />
                                <Setter Property="Button.Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            </StackPanel>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="30" FontFamily="/Fonts/#Roboto" FontWeight="Bold"
                       Text="{x:Static language:Lang.createBackupWork}"/>
        </Grid>
        <TextBlock Grid.Column="1" Grid.Row="1" Background="Gray"/>

        <StackPanel Grid.Column="1" Grid.Row="2" VerticalAlignment="Center">
            <Label x:Name="nameLabel" Content="{x:Static language:Lang.name}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <Border CornerRadius="10"
                    Background="White"
                    Width="auto">
                <TextBox x:Name="_name"
                         Margin="1" Padding="5" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         FontFamily="/Fonts/#Roboto" FontSize="17" Foreground="Black"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" VerticalAlignment="Center">
            <Label x:Name="srcLabel" Content="{x:Static language:Lang.source}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="291*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="10"
                        Background="White"
                        Width="auto">
                    <TextBox x:Name="_src" Grid.ColumnSpan="2"
                         Margin="1" Padding="5" BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         FontFamily="/Fonts/#Roboto" FontSize="17" Foreground="Black"/>
                </Border>
                <Button x:Name="srcOpenFolderButton" Grid.Column="2" Width="40"
                        HorizontalAlignment="Right"
                        Click="SrcOpenFolderButton_Click"
                        FontFamily="/Fonts/#Roboto" FontSize="17" FontWeight="Bold"
                        Style="{StaticResource PickFolderButtonStyle}">...</Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="4" VerticalAlignment="Center">
            <Label x:Name="dstLabel" Content="{x:Static language:Lang.destination}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="291*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="10"
                        Background="White"
                        Width="auto">
                    <TextBox x:Name="_dst" Grid.ColumnSpan="2"
                             Margin="1" Padding="5" BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             FontFamily="/Fonts/#Roboto" FontSize="17" Foreground="Black"/>
                </Border>
                <Button x:Name="dstOpenFolderButton" Grid.Column="2"
                        Width="40" HorizontalAlignment="Right"
                        Click="DstOpenFolderButton_Click"
                        FontFamily="/Fonts/#Roboto" FontSize="17" FontWeight="Bold"
                        Style="{StaticResource PickFolderButtonStyle}">...</Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="5" VerticalAlignment="Center">
            <Label x:Name="mirLabel" Content="{x:Static language:Lang.mirror}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="291*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="10"
                        Background="White"
                        Width="auto">
                    <TextBox x:Name="_mir" Grid.ColumnSpan="2"
                             Margin="1" Padding="5" BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             FontFamily="/Fonts/#Roboto" FontSize="17" Foreground="Black"/>
                </Border>
                <Button x:Name="mirOpenFolderButton" Grid.Column="2"
                        Width="40" HorizontalAlignment="Right"
                        Click="mirOpenFolderButton_Click"
                        FontFamily="/Fonts/#Roboto" FontSize="17" FontWeight="Bold"
                        Style="{StaticResource PickFolderButtonStyle}">...</Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="6" VerticalAlignment="Center">
            <Label Content="{x:Static language:Lang.backupType}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <ComboBox x:Name="_backupType" SelectedIndex="0" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type model:BackupType}}}"/>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Label Content="{x:Static language:Lang.checkEncrypt}"
                   FontFamily="/Fonts/#Roboto" FontSize="13" FontWeight="Medium"></Label>
            <CheckBox Grid.Column="1" x:Name="_isCrypted" BorderBrush="Black" HorizontalAlignment="Left" VerticalAlignment="Center">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="LightGreen" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </Grid>
        <Button Grid.Column="1" Grid.Row="8"
                Content="{x:Static language:Lang.add}"
                Width="300" Height="75"
                FontSize="20"
                Style="{StaticResource CreateButtonStyle}"
                Click="AddWork_Click"/>
    </Grid>
</Page>
