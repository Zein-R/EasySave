<Window x:Class="EasySave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:EasySave.Langs"
        mc:Ignorable="d"
        Title="EasySave" MinHeight="720" MinWidth="1280">


    <Grid Background="#FEFADF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#FAEDCD"
                    Height="auto">

            <RadioButton Content="{x:Static language:Lang.dashboard}" IsChecked="True"
                 Height="50" FontSize="17" FontFamily="/Fonts/#Roboto"
                 Style="{StaticResource MenuButtonTheme}"
                 Click="ChangePage" Tag="menu"/>

            <RadioButton Content="{x:Static language:Lang.createBackupWork}"
                 Height="50" FontSize="17" FontFamily="/Fonts/#Roboto"
                 Style="{StaticResource MenuButtonTheme}"
                 Click="ChangePage" Tag="addWork"/>
            <RadioButton Content="{x:Static language:Lang.settings}"
                 Height="50" FontSize="17" FontFamily="/Fonts/#Roboto"
                 Style="{StaticResource MenuButtonTheme}"
                 Click="ChangePage" Tag="settings"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
            <Button Content="{x:Static language:Lang.socket}"
                    Margin="10,5,10,5"
                    Height="40"
                    Style="{StaticResource ButtonStyle}"
                    Click="InitSocket"/>
            <Button Content="{x:Static language:Lang.logFiles}"
                    Height="40"
                    Margin="10,5,10,20"
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>

        <Frame Grid.Column="1" Grid.Row="0" Content="{Binding}" NavigationUIVisibility="Hidden"/>
    </Grid>
    
    
       
</Window>
